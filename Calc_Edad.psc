Algoritmo Calc_Edad
	Definir nombre Como Caracter
	Definir año Como Entero
	Definir edadActual Como Entero
	Escribir "Ingrese Nombre:"
	Leer nombre
	Escribir "Ingrese año de nacimiento"
	Leer año
	edadActual = 2026-año
	Escribir "Tu nombre es:", nombre
	Escribir "Tu edad es:", edadActual
FinAlgoritmo
