Algoritmo NumPotencia
	// Cree un Programa que solicite 2 valores numericos, uno asignado a la base
	// y otro asignado a la potencia, luego brindar el resultado
	Definir num1, num2, num3 Como Entero
	Escribir 'Ingrese el primer valor como base:'
	Leer num1
	Escribir 'Ingrese el segundo valor como potencia:'
	Leer num2
	num3 <- num1^num2
	Escribir 'El resultado es:', num3
FinAlgoritmo
